# Copy to .env to override. Every value below is a default the code already
# uses, so the project runs with no .env at all against the Postgres in
# docker-compose.yml.

# Where the application and `npm run db:reset` connect.
DATABASE_URL=postgres://ottodot:ottodot@localhost:5433/ottodot

# Whether `npm run db:reset` starts the bundled Postgres first. Set to 0 when
# DATABASE_URL points at a server you already run.
USE_BUNDLED_DB=1

# How long a seat stays held before the sweep releases it. Applies to
# pending_payment and nothing else.
HOLD_TTL_SECONDS=600

# How long the mock provider takes over a tok_slow / tok_refund_fail charge.
# Raise it to walk the refund path by hand; the default window is deliberately
# narrow.
SLOW_CHARGE_MS=1500

PORT=3000
